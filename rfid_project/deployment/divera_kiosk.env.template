# Presency Divera kiosk switcher -- configuration template.
# Copy this file to divera_kiosk.env (gitignored) and fill in the real
# Divera247 access key:
#   sudo cp /home/pi/WIFI_based_RFID_attendance-system/rfid_project/deployment/divera_kiosk.env.template /home/pi/WIFI_based_RFID_attendance-system/rfid_project/deployment/divera_kiosk.env
#   sudo nano /home/pi/WIFI_based_RFID_attendance-system/rfid_project/deployment/divera_kiosk.env
# Then restart the service: sudo systemctl restart divera-kiosk.service
DIVERA_ACCESS_KEY=your-divera247-access-key-here
# Shared secret that authenticates the RFID serial bridge to Django's /process/.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# LEAVE EMPTY until you generate a real value — empty fails closed (403) and
# prevents deploying with a publicly-known placeholder.
# The rfid-serial-bridge.service must load this file (EnvironmentFile=) so the
# bridge sends the same token as X-Bridge-Token.
BRIDGE_TOKEN=
DIVERA_API_URL=https://app.divera247.com/api/v2/pull/all
DIVERA_PAGE_URL=http://127.0.0.1:8000/alarm/ # Override to https://www.divera247.com/ if you prefer external Divera site
KIOSK_HOME_URL=http://127.0.0.1:8000/
CDP_BASE=http://127.0.0.1:9222
POLL_SECONDS=15
ALARM_VISIBLE_SECONDS=1200
